@page "/update-report"

<div class="page">
    <header class="topbar">
        <div class="topbar-left">
            <span class="avatar-icon">👤</span>
            <h1>Tidsrapport</h1>
        </div>
        <div class="topbar-right">Anna Andersson ▾</div>
    </header>

    <main class="card">
        <h2>Ändra rapport</h2>
        <p class="subtitle">Välj en rapport från aktuell månad och ändra antal timmar.</p>

        <div class="field-row">
            <div class="field">
                <label>Rapport</label>
                <select class="input">
                    <option value="">Välj rapport</option>
                    <option value="1">Acme AB – 2026-09-08 (4,0 h)</option>
                    <option value="2">Globex Solutions – 2026-09-08 (2,5 h)</option>
                    <option value="3">Initech – 2026-09-08 (1,0 h)</option>
                </select>
            </div>
        </div>
    </main>
</div>

