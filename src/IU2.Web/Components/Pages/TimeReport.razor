@page "/tidrapportering"
@using IU2.Core.services
@inject TimeReportService TimeReportService

<h3>Rapportera timmar</h3>

<EditForm Model="@model" OnValidSubmit="HandleSubmit">
    <div class="mb-3">
        <label>Datum</label>
        <InputDate @bind-Value="model.Date" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Kund</label>
        <select class="form-select" @bind="model.CustomerId">
            <option value="0">Välj kund</option>
            @foreach (var customer in TimeReportService.Customers)
            {
                <option value="@customer.Id">@customer.Name</option>
            }
        </select>
    </div>

    <div class="mb-3"> 
        <label>Timmar</label>
        <InputNumber @bind-Value="model.Hours" class="form-control" step="0.5" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (showSaved)
    {
        <div class="alert alert-success">Sparat</div>
    }

    <button type="submit" class="btn btn-primary">Spara</button>
</EditForm>

<h4 class="mt-4">Rapporterade timmar för @model.Date.ToShortDateString()</h4>
<ul>
    @foreach (var r in TimeReportService.GetReportsForDate(model.Date))
    {
        var customer = TimeReportService.Customers.FirstOrDefault(c => c.Id == r.CustomerId);
        <li>@customer?.Name: @r.Hours timmar</li>
    }
</ul>

@code {
    private TimeReportFormModel model = new TimeReportFormModel { Date = DateTime.Today };
    private string? errorMessage;
    private bool showSaved;

    private class TimeReportFormModel
    {
        public DateTime Date { get; set; }
        public int CustomerId { get; set; }
        public decimal Hours { get; set; }
    }

    private void HandleSubmit()
    {
        showSaved = false;
        errorMessage = null;

        if (model.CustomerId == 0)
        {
            errorMessage = "Du måste välja en kund.";
            return;
        }

        var (success, error) = TimeReportService.AddReport(model.Date, model.CustomerId, model.Hours);

        if (!success)
        {
            errorMessage = error;
            return;
        }

        showSaved = true;
        model.Hours = 0; // Reset hours after successful submission
    }
}
